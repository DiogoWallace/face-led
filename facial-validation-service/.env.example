# Copie para .env e preencha. O .env NUNCA é versionado.
# Gere segredos locais com: make secrets  (imprime valores aleatórios)

APP_ENV=local
APP_NAME=facial-validation-service
LOG_LEVEL=INFO

# ---- Portas no host (127.0.0.1). Faixa 181xx livre no inventário do WSL ----
FVS_API_PORT=18100
FVS_POSTGRES_PORT=18110
FVS_REDIS_PORT=18120
FVS_S3_PORT=18130

# ---- PostgreSQL ----
POSTGRES_USER=facial_validation
POSTGRES_PASSWORD=
POSTGRES_DB=facial_validation
POSTGRES_TEST_DB=facial_validation_test
# Dentro do compose a URL é montada a partir das variáveis acima.
# Para ferramentas no host: postgresql+asyncpg://USER:PASS@127.0.0.1:18110/facial_validation
DATABASE_URL=

# ---- Redis ----
REDIS_PASSWORD=
# Dentro do compose: redis://:PASS@redis:6379/0
REDIS_URL=

# ---- Object storage S3 compatível ----
# Dentro do compose: http://s3:8333 | no host: http://127.0.0.1:18130
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=facial-validation-captures
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Somente local/test: cria o bucket privado na inicialização.
S3_AUTO_CREATE_BUCKET=true

# ---- Componentes biométricos independentes (ADR-006) ----
# "none" = componente não configurado: o processamento termina em ERROR.
# OpenCV: BIOMETRIC_DETECTOR=opencv-yunet, BIOMETRIC_QUALITY_ASSESSOR=opencv,
# BIOMETRIC_EMBEDDER=opencv-sface, BIOMETRIC_COMPARATOR=opencv-sface.
# Detector e embedder exigem os modelos (make models); o medidor de qualidade não.
BIOMETRIC_DETECTOR=none
BIOMETRIC_QUALITY_ASSESSOR=none
BIOMETRIC_EMBEDDER=none
BIOMETRIC_COMPARATOR=none
# Liveness: none | active (ativo próprio, ADR-010; usa os modelos do OpenCV).
LIVENESS_PROVIDER=none
# REQUIRED | DISABLED_FOR_EVALUATION (este último somente em APP_ENV=local|test)
LIVENESS_REQUIREMENT=REQUIRED

# ---- Liveness ativo (LIVENESS_PROVIDER=active, ADR-010) ----
# Valores INICIAIS, PENDING CALIBRATION (nenhum medido com capturas reais).
# Fora de APP_ENV=local|test o serviço exige CALIBRATED e o limiar de mesma pessoa.
LIVENESS_CALIBRATION_STATUS=PENDING_CALIBRATION
# Similaridade mínima selfie x quadros-prova. SEM padrão: vazio => INCONCLUSIVE (ERROR).
LIVENESS_SAME_PERSON_MIN_SIMILARITY=
LIVENESS_CHALLENGE_STEPS=3
LIVENESS_SESSION_TTL_SECONDS=120
LIVENESS_MIN_FRAMES=8
# ~5 quadros/s na captura guiada: 120 cobrem ~24 s (cada instrução leva ~3 s de reação).
LIVENESS_MAX_FRAMES=120
LIVENESS_FRAME_MAX_BYTES=300000
LIVENESS_MIN_TRACKED_RATIO=0.8
LIVENESS_FRONTAL_MAX_YAW=0.15
LIVENESS_TURN_MIN_YAW=0.35
LIVENESS_TURN_MIN_EYE_RATIO=0.65
LIVENESS_CLOSER_MIN_SCALE=1.25
LIVENESS_MAX_YAW_JUMP=0.25
LIVENESS_MAX_SCALE_JUMP=0.25

# ---- Runtime OpenCV (só o worker carrega os modelos) ----
# Arquivos ONNX fora do Git, conferidos por SHA-256 ao baixar e ao carregar.
BIOMETRIC_MODELS_DIR=models
# Uma instância de cada modelo por thread (YuNet compartilhado dá segfault).
# Escalar = mais réplicas do worker, não mais threads.
BIOMETRIC_INFERENCE_THREADS=1
# cv2.setNumThreads; vazio = padrão do OpenCV (todos os núcleos)
BIOMETRIC_OPENCV_THREADS=
# Score mínimo de detecção do YuNet (valor do POC; revisar na calibração)
BIOMETRIC_DETECTOR_SCORE_THRESHOLD=0.6

# ---- FaceMatchPolicy ----
# Modelo ao qual a política se aplica (ex.: opencv-sface / 2021dec).
BIOMETRIC_MODEL=
BIOMETRIC_MODEL_VERSION=
FACE_MATCH_POLICY_VERSION=
# Referência LFW para opencv-sface/2021dec: 0.3443. NÃO é valor de produção.
FACE_MATCH_MIN_SIMILARITY=
# PENDING_CALIBRATION só é aceito em local/test. CALIBRATED exige FAR alvo e referência.
FACE_MATCH_CALIBRATION_STATUS=PENDING_CALIBRATION
# PENDING BUSINESS DECISION
FACE_MATCH_TARGET_FAR=
FACE_MATCH_CALIBRATION_REFERENCE=

# ---- QualityGate (PENDING CALIBRATION) ----
# Vazio = critério não aplicado. Fora de local/test todos são obrigatórios.
QUALITY_MIN_FACE_PX=
QUALITY_MIN_FACE_RATIO=
QUALITY_MIN_SHARPNESS=
QUALITY_MIN_BRIGHTNESS=
QUALITY_MAX_BRIGHTNESS=

# ---- Retenção da captura (selfie) após o processamento ----
# PENDING LEGAL/BUSINESS DECISION. KEEP = comportamento original (fica no storage).
# DELETE_AFTER_PROCESSING = apaga do storage ao terminar (APPROVED/REJECTED/ERROR/EXPIRED);
# o template cifrado do cadastro não é afetado.
CAPTURE_RETENTION=KEEP

# ---- Webhook de resultado (ADR-009) ----
# URL e segredo são por tenant, via CLI: python -m app.cli set-webhook --slug X --url https://...
WEBHOOK_TIMEOUT_SECONDS=10

# ---- Criptografia do template biométrico (32 bytes base64 url-safe) ----
TEMPLATE_ENCRYPTION_KEY=

# ---- Limites ----
MAX_CAPTURE_BYTES=5242880
VERIFICATION_TTL_SECONDS=900

# ---- Observabilidade (opcional) ----
OTEL_ENABLED=false
OTEL_SERVICE_NAME=facial-validation-service
