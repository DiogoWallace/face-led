# Copie para bridge/.env. Nunca versione o .env.
# Porta da placa no WSL depois do usbipd attach (Uno clone CH340 -> /dev/ttyUSB0).
FACE_LED_SERIAL_PORT=/dev/ttyUSB0
FACE_LED_BAUD=115200
# Só 127.0.0.1: o worker (Docker Desktop) chega por http://host.docker.internal:18200/webhook
FACE_LED_HOST=127.0.0.1
FACE_LED_PORT=18200
# Segredo whsec_... mostrado UMA vez pelo set-webhook do facial-validation-service.
FACE_LED_WEBHOOK_SECRET=
FACE_LED_SIGNATURE_TOLERANCE_SECONDS=300
# Eventos que acionam o LED, separados por vírgula.
FACE_LED_EVENT_TYPES=verification.completed
